# Usage: git shallow-clone -b <ref> <url> <dir>
# Unlike "git clone -b", the ref can be a commit SHA as well as a branch or tag.

set -euo pipefail

while getopts "b:" OPT ; do
    case "${OPT}" in
        b) REF="${OPTARG}" ;;
        *) exit 1 ;;
    esac
done
shift $((OPTIND - 1))

mkdir -p "${2}"
cd "${2}"
git init -q
git remote add origin "${1}"
git fetch -q --depth 1 origin "${REF}"
git checkout -q FETCH_HEAD
